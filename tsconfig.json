{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "cypress/e2e/user-flows.cy.js",
    "jest",
    "__tests__/helpers/helpers.js",
    "__tests__/helpers/conversionHelpers.test.js",
    "__tests__/helpers/validationHelpers.test.js",
    "__tests__/helpers/calculationHelpers.test.js"
  ],
  "exclude": ["node_modules"]
}
